# SecurePass Backend – Beispiel-Konfiguration
# Kopiere diese Datei zu ".env" und passe die Werte an. Die echte .env wird NICHT eingecheckt.

# Server
PORT=3000
NODE_ENV=development

# Frontend-Origin (fuer CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securepass
DB_USER=securepass
DB_PASSWORD=change_me

# JWT-Secrets (spaeter genutzt) – mit z.B. `openssl rand -hex 32` generieren
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
