# SecurePass backend – example configuration.
# Copy this file to ".env" and adjust the values. The real .env is not committed.

# Server
PORT=3000
NODE_ENV=development

# Frontend origin (for CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securepass
DB_USER=securepass
DB_PASSWORD=change_me

# JWT secrets – generate with e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# Token lifetimes (optional, defaults shown)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
