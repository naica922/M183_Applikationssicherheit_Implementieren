{
  "info": {
    "name": "SecurePass API",
    "description": "Demo collection for the SecurePass backend (M183). Run top to bottom: Register -> Login -> 2FA -> Vault CRUD -> Audit -> Refresh/Logout. Login auto-saves the access token and the CSRF token; Create Entry auto-saves the entry id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "username", "value": "postman_demo" },
    { "key": "password", "value": "superSecret123" },
    { "key": "accessToken", "value": "" },
    { "key": "csrfToken", "value": "" },
    { "key": "entryId", "value": "" },
    { "key": "totpCode", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "2. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "3. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.accessToken) {",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "}",
              "const csrf = pm.cookies.get('csrfToken');",
              "if (csrf) {",
              "  pm.collectionVariables.set('csrfToken', csrf);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "4. Login (wrong password -> 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrongPassword99\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "5. 2FA Setup (returns QR + otpauth)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/auth/2fa/setup", "host": ["{{baseUrl}}"], "path": ["auth", "2fa", "setup"] }
      }
    },
    {
      "name": "6. 2FA Enable (set totpCode first)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"totpCode\": \"{{totpCode}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/2fa/enable", "host": ["{{baseUrl}}"], "path": ["auth", "2fa", "enable"] }
      }
    },
    {
      "name": "7. Login with 2FA code",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"totpCode\": \"{{totpCode}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "8. Vault - Create entry",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.entry && body.entry.id) {",
              "  pm.collectionVariables.set('entryId', body.entry.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"website\": \"github.com\",\n  \"username\": \"naica922\",\n  \"password\": \"my-stored-secret-123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/vault", "host": ["{{baseUrl}}"], "path": ["vault"] }
      }
    },
    {
      "name": "9. Vault - List entries",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/vault", "host": ["{{baseUrl}}"], "path": ["vault"] }
      }
    },
    {
      "name": "10. Vault - Get entry (decrypts password)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/vault/{{entryId}}", "host": ["{{baseUrl}}"], "path": ["vault", "{{entryId}}"] }
      }
    },
    {
      "name": "11. Vault - Update entry",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"website\": \"github.com\",\n  \"username\": \"naica922\",\n  \"password\": \"rotated-secret-456\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/vault/{{entryId}}", "host": ["{{baseUrl}}"], "path": ["vault", "{{entryId}}"] }
      }
    },
    {
      "name": "12. Audit - My events",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/audit", "host": ["{{baseUrl}}"], "path": ["audit"] }
      }
    },
    {
      "name": "13. Refresh (rotates token, needs CSRF header)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.accessToken) {",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "}",
              "const csrf = pm.cookies.get('csrfToken');",
              "if (csrf) {",
              "  pm.collectionVariables.set('csrfToken', csrf);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
        "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
      }
    },
    {
      "name": "14. Vault - Delete entry",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/vault/{{entryId}}", "host": ["{{baseUrl}}"], "path": ["vault", "{{entryId}}"] }
      }
    },
    {
      "name": "15. Logout (needs CSRF header)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
        "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
      }
    }
  ]
}
